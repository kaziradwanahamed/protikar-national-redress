# Django Core
DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_SECRET_KEY=replace-with-64-char-cryptographically-random-secret
DJANGO_DEBUG=False
DEMO_MODE=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,grievance.gov.bd
CSRF_TRUSTED_ORIGINS=https://grievance.gov.bd,http://localhost:8000

# PostgreSQL 16 + PostGIS
POSTGRES_DB=bd_grievance
POSTGRES_USER=grievance_app
POSTGRES_PASSWORD=replace-with-strong-db-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis (Cache, Channels, Celery Broker)
REDIS_PASSWORD=replace-with-strong-redis-password
REDIS_URL=redis://:replace-with-strong-redis-password@redis:6379/0
CELERY_BROKER_URL=redis://:replace-with-strong-redis-password@redis:6379/1
CELERY_RESULT_BACKEND=redis://:replace-with-strong-redis-password@redis:6379/2

# Apache Kafka (KRaft)
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_PREFIX=bd.grievance

# MinIO (S3-Compatible Encrypted Media Store)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=replace-with-strong-minio-password
MINIO_ENDPOINT_URL=http://minio:9000
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_BUCKET_MEDIA=grievance-media-encrypted
MINIO_KMS_SECRET_KEY=my-minio-key:OSMM567890123456789012345678901234567890123=
# Part 2: Citizen SSO (myGov / Porichoy OIDC) & Mobile OTP
IDENTITY_PROVIDER_MODE=mock
UCT_HMAC_SECRET=replace-with-64-char-hmac-secret-for-uct-generation
MYGOV_OIDC_AUTHORIZE_URL=https://idp.mygov.bd/oauth2/authorize
MYGOV_OIDC_TOKEN_URL=https://idp.mygov.bd/oauth2/token
MYGOV_OIDC_USERINFO_URL=https://idp.mygov.bd/oauth2/userinfo
MYGOV_OIDC_CLIENT_ID=bd-grievance-platform
MYGOV_OIDC_CLIENT_SECRET=replace-with-mygov-client-secret
MYGOV_OIDC_REDIRECT_URI=http://localhost:8000/api/v1/accounts/sso/mygov/callback/
PORICHOY_API_URL=https://api.porichoygov.com/api/v2/verifications/autofill
PORICHOY_API_KEY=replace-with-porichoy-api-key

# Part 2: Whistleblower Envelope Encryption (HashiCorp Vault Transit Engine)
VAULT_MODE=local_dev
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=dev-root-vault-token-change-in-prod
VAULT_TRANSIT_KEY=whistleblower-transit-key
VAULT_LOCAL_MASTER_KEY=local-dev-master-key-change-in-production-32b

# Part 2: Government Official SSO (Doptor / Nothi Organogram)
DOPTOR_PROVIDER_MODE=mock
DOPTOR_SSO_TOKEN_URL=https://idp.doptor.gov.bd/oauth2/token
DOPTOR_ORGANOGRAM_API_URL=https://api.doptor.gov.bd/v1/organogram
DOPTOR_CLIENT_ID=bd-grievance-doptor
DOPTOR_CLIENT_SECRET=replace-with-doptor-client-secret
# Part 4: AI Triage Pipeline (Whisper/Conformer ASR, VLM+OCR, Hierarchical Classifier)
AI_PROVIDER_MODE=mock
AI_WORKER_BASE_URL=http://ai-worker:8001
AI_WORKER_API_KEY=replace-with-ai-worker-api-key
AI_AUTO_ROUTE_THRESHOLD=0.85
AI_GRO_FLAG_THRESHOLD=0.60
DEDUP_RADIUS_METERS=200
# Part 5: Disaster Surge Architecture & 3-Tier National ESB / Omnichannel
DISASTER_SURGE_MULTIPLIER=5.0
DISASTER_H3_RESOLUTION=8
KAFKA_PROVIDER_MODE=mock
ESB_PROVIDER_MODE=mock
ESB_WEBHOOK_SIGNING_SECRET=replace-with-64-char-esb-hmac-secret
WHATSAPP_VERIFY_TOKEN=replace-with-whatsapp-verify-token
MESSENGER_VERIFY_TOKEN=replace-with-messenger-verify-token

# Part 10: Standalone FastAPI AI Cognitive Triage Microservice
AI_SERVICE_URL=http://ai-service:8001
AI_SERVICE_TIMEOUT_SECONDS=8.0

# Part 11: Google Maps JavaScript API + Places (leave blank for automatic fallback map)
GOOGLE_MAPS_API_KEY=""
